#version 460
// Temporal AA (optional: --taa on|off). Jittered projection (Halton 2,3 x8), motion vectors from the G-buffer pass (unjittered
// matrices, incl. wind on foliage/grass), closest-depth 3x3 velocity dilation, Catmull-Rom history fetch (sharp, no bilinear blur),
// variance clipping in YCoCg on tonemapped values (Salvi 2016), luminance-weighted blend, history reset on camera cuts.
// Minimal-blur settings per the handbook warning: 0.1 feedback only for static pixels, faster response in motion, light sharpen in post.
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 1) uniform sampler2D curTex;
layout(set = 0, binding = 2) uniform sampler2D histTex;
layout(set = 0, binding = 3) uniform sampler2D velTex;
layout(set = 0, binding = 4) uniform sampler2D depthTex;
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D outHist;
vec3 tm(vec3 c) { return c / (1.0 + max(c.r, max(c.g, c.b))); }
vec3 itm(vec3 c) { return c / max(1.0 - max(c.r, max(c.g, c.b)), 1e-4); }
vec3 toYC(vec3 c) { return vec3(dot(c, vec3(0.25, 0.5, 0.25)), dot(c, vec3(0.5, 0.0, -0.5)), dot(c, vec3(-0.25, 0.5, -0.25))); }
vec3 fromYC(vec3 y) { return vec3(y.x + y.y - y.z, y.x + y.z, y.x - y.y - y.z); }
vec3 catmull(vec2 uv) { // 5-tap Catmull-Rom (Jimenez / Karis)
  vec2 sz = vec2(textureSize(histTex, 0)), sp = uv * sz, t1 = floor(sp - 0.5) + 0.5, f = sp - t1;
  vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f)), w1 = 1.0 + f * f * (-2.5 + 1.5 * f), w2 = f * (0.5 + f * (2.0 - 1.5 * f)), w3 = f * f * (-0.5 + 0.5 * f);
  vec2 w12 = w1 + w2, t0 = (t1 - 1.0) / sz, t3 = (t1 + 2.0) / sz, t12 = (t1 + w2 / w12) / sz;
  vec3 c = texture(histTex, vec2(t12.x, t0.y)).rgb * (w12.x * w0.y) + texture(histTex, vec2(t0.x, t12.y)).rgb * (w0.x * w12.y) + texture(histTex, t12).rgb * (w12.x * w12.y)
         + texture(histTex, vec2(t3.x, t12.y)).rgb * (w3.x * w12.y) + texture(histTex, vec2(t12.x, t3.y)).rgb * (w12.x * w3.y);
  float ws = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y; return max(c / ws, 0.0);
}
void main() {
  ivec2 px = ivec2(gl_GlobalInvocationID.xy); if (any(greaterThanEqual(px, ivec2(F.res.xy)))) return;
  vec2 uv = (vec2(px) + 0.5) * F.res.zw;
  vec3 cur = texture(curTex, uv).rgb;
  vec3 m1 = vec3(0), m2 = vec3(0); float dmin = 2.0; ivec2 best = px;
  for (int y = -1; y <= 1; y++) for (int x = -1; x <= 1; x++) { ivec2 q = clamp(px + ivec2(x, y), ivec2(0), ivec2(F.res.xy) - 1);
    vec3 c = toYC(tm(texelFetch(curTex, q, 0).rgb)); m1 += c; m2 += c * c; float d = texelFetch(depthTex, q, 0).r; if (d < dmin) { dmin = d; best = q; } }
  vec2 vel = texelFetch(velTex, best, 0).xy;
  if (dmin >= 1.0) { vec3 wp = worldFromDepth(uv, 0.99999); vec4 pc = F.prevVpNJ * vec4(wp, 1.0); vec4 cc = F.vpNJ * vec4(wp, 1.0); vel = (cc.xy / cc.w - pc.xy / pc.w) * 0.5; } // sky: camera motion
  vec2 huv = uv - vel;
  if (F.taa.z < 0.5 || F.opt.z > 0.5 || any(lessThan(huv, vec2(0))) || any(greaterThan(huv, vec2(1)))) { imageStore(outHist, px, vec4(cur, 1)); return; }
  float motion = length(vel * F.res.xy);
  float gam = 1.0; // (1.5 for static pixels measured worse on the grass benchmark)
  vec3 mu = m1 / 9.0, sig = sqrt(max(m2 / 9.0 - mu * mu, 0.0)); vec3 lo = mu - sig * gam, hi = mu + sig * gam;
  vec3 h = toYC(tm(catmull(huv)));
  vec3 ctr = 0.5 * (hi + lo), ext = 0.5 * (hi - lo) + 1e-4; vec3 dv = h - ctr; vec3 r = abs(dv / ext); float mx = max(r.x, max(r.y, r.z)); if (mx > 1.0) h = ctr + dv / mx; // clip to box
  vec3 c = toYC(tm(cur));
  float a = mix(0.1, 0.3, clamp(motion / 6.0, 0.0, 1.0));
  float wc = a / (1.0 + c.x), wh = (1.0 - a) / (1.0 + h.x); vec3 o = (c * wc + h * wh) / (wc + wh);
  imageStore(outHist, px, vec4(itm(fromYC(o)), 1));
}
