#version 460
// Sun visibility mask. RAY_QUERY=1: one jittered cone ray per pixel against the TLAS (hardware RT, RTX 3090/4090);
// otherwise: 2 shadow-map cascades (near dynamic, far cached static) with PCSS-lite blocker search + 16-tap Poisson PCF.
#extension GL_GOOGLE_include_directive : enable
#if RAY_QUERY
#extension GL_EXT_ray_query : enable
#endif
#include "common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 1) uniform sampler2D depthTex;
layout(set = 0, binding = 2) uniform sampler2D normalTex;
layout(set = 0, binding = 3, r8) uniform writeonly image2D outMask;
layout(set = 0, binding = 4) uniform sampler2D shadowMap0;
layout(set = 0, binding = 5) uniform sampler2D shadowMap1;
#if RAY_QUERY
layout(set = 0, binding = 6) uniform accelerationStructureEXT tlas;
#endif
const vec2 POISSON[16] = vec2[](vec2(-0.94,-0.40),vec2(0.95,-0.77),vec2(-0.09,-0.93),vec2(0.34,0.29),vec2(-0.92,0.46),vec2(-0.82,-0.88),vec2(-0.38,0.28),vec2(0.97,0.76),
  vec2(0.44,-0.98),vec2(0.54,0.80),vec2(-0.26,-0.43),vec2(-0.66,0.94),vec2(0.17,-0.22),vec2(0.79,0.19),vec2(-0.14,0.67),vec2(0.24,0.99));
float cascade(sampler2D sm, mat4 vp, vec3 p, float texel, float rot) {
  vec4 c = vp * vec4(p, 1.0); vec3 s = c.xyz / c.w; vec2 uv = s.xy * 0.5 + 0.5; if (any(lessThan(uv, vec2(0))) || any(greaterThan(uv, vec2(1)))) return -1.0;
  float z = s.z - 0.0006; mat2 R = mat2(cos(rot), sin(rot), -sin(rot), cos(rot));
  float blk = 0.0, nb = 0.0; for (int i = 0; i < 8; i++) { float d = texture(sm, uv + R * POISSON[i] * texel * 6.0).r; if (d < z) { blk += d; nb += 1.0; } }
  if (nb < 0.5) return 1.0; float pen = clamp((z - blk / nb) * 600.0, 1.0, 8.0);
  float lit = 0.0; for (int i = 0; i < 16; i++) lit += step(z, texture(sm, uv + R * POISSON[i] * texel * pen).r);
  return lit / 16.0;
}
void main() {
  ivec2 px = ivec2(gl_GlobalInvocationID.xy); if (any(greaterThanEqual(px, ivec2(F.res.xy)))) return;
  vec2 uv = (vec2(px) + 0.5) * F.res.zw; float d = texture(depthTex, uv).r; if (d >= 1.0) { imageStore(outMask, px, vec4(1)); return; }
  vec3 p = worldFromDepth(uv, d); vec3 n = texture(normalTex, uv).xyz; float noise = sampleNoise(vec2(px), p) * 6.2831;
  float vis = 1.0;
#if RAY_QUERY
  if (F.frameInfo.y != 0u) {
    vec3 L = F.sunDir.xyz, T = normalize(cross(L, abs(L.y) < 0.9 ? vec3(0, 1, 0) : vec3(1, 0, 0))), B = cross(L, T);
    float r = F.sunDir.w * sqrt(fract(noise * 7.13)); vec3 dir = normalize(L + (T * cos(noise) + B * sin(noise)) * r);
    rayQueryEXT q; rayQueryInitializeEXT(q, tlas, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 0xFF, p + n * 0.03, 0.01, dir, 2000.0);
    while (rayQueryProceedEXT(q)) {}
    vis = rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionNoneEXT ? 1.0 : 0.0;
    imageStore(outMask, px, vec4(vis)); return;
  }
#endif
  vec3 pb = p + n * 0.04;
  float v0 = cascade(shadowMap0, F.shadowVP[0], pb, 1.0 / 2048.0, noise);
  vis = v0 >= 0.0 ? v0 : max(cascade(shadowMap1, F.shadowVP[1], pb, 1.0 / 4096.0, noise), 0.0);
  float v1 = cascade(shadowMap1, F.shadowVP[1], pb, 1.0 / 4096.0, noise); if (v1 >= 0.0) vis = min(vis, v1); // static casters outside the near box
  imageStore(outMask, px, vec4(vis));
}
