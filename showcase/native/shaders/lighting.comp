#version 460
// Direct lighting only (sun GGX + Lambert with shadow mask). Output feeds the GI pass (as the screen-space radiance source)
// and the composite. Ambient/GI is added in composite.comp.
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 1) uniform sampler2D depthTex;
layout(set = 0, binding = 2) uniform sampler2D albedoTex;
layout(set = 0, binding = 3) uniform sampler2D normalTex;
layout(set = 0, binding = 4) uniform sampler2D shadowMask;
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D outDirect;
float D_GGX(float nh, float a) { float a2 = a * a, d = nh * nh * (a2 - 1.0) + 1.0; return a2 / (PI * d * d); }
float V_SmithGGX(float nv, float nl, float a) { float a2 = a * a; float gv = nl * sqrt(nv * nv * (1.0 - a2) + a2), gl = nv * sqrt(nl * nl * (1.0 - a2) + a2); return 0.5 / max(gv + gl, 1e-5); }
void main() {
  ivec2 px = ivec2(gl_GlobalInvocationID.xy); if (any(greaterThanEqual(px, ivec2(F.res.xy)))) return;
  vec2 uv = (vec2(px) + 0.5) * F.res.zw; float d = texture(depthTex, uv).r; if (d >= 1.0) { imageStore(outDirect, px, vec4(0)); return; }
  vec3 p = worldFromDepth(uv, d); vec4 A = texture(albedoTex, uv), N = texture(normalTex, uv);
  if (N.w < 0.0) { imageStore(outDirect, px, vec4(0)); return; } // material group in flat/debug mode: unlit
  bool fol = N.w > 3.5; if (fol) { N.w -= 4.0; A.a = 0.0; } // foliage: albedo.a = AO, not metalness
  bool nospec = N.w > 1.5; if (nospec) N.w -= 2.0;
  vec3 n = normalize(N.xyz), v = normalize(F.camPos.xyz - p), l = F.sunDir.xyz, h = normalize(v + l);
  float nl = max(dot(n, l), 0.0), nv = max(dot(n, v), 1e-3), nh = max(dot(n, h), 0.0), vh = max(dot(v, h), 0.0);
  float a = max(N.w * N.w, 0.002); vec3 f0 = mix(vec3(0.04), A.rgb, A.a); vec3 Fs = f0 + (1.0 - f0) * pow(1.0 - vh, 5.0);
  vec3 spec = nospec ? vec3(0) : D_GGX(nh, a) * V_SmithGGX(nv, nl, a) * Fs; vec3 diff = (1.0 - Fs) * (1.0 - A.a) * A.rgb / PI;
  float sh = texture(shadowMask, uv).r;
  imageStore(outDirect, px, vec4((diff + spec) * F.sunColor.rgb * nl * sh, 1.0));
}
