#version 460
// Tonemap (ACES fitted, Hill) + bloom -> display-referred sRGB in an rgba8 image. AA and lens effects run after this.
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 1) uniform sampler2D hdrTex;
layout(set = 0, binding = 2) uniform sampler2D bloomTex;
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D outLdr;
const mat3 ACESIn = mat3(0.59719, 0.07600, 0.02840, 0.35458, 0.90834, 0.13383, 0.04823, 0.01566, 0.83777);
const mat3 ACESOut = mat3(1.60475, -0.10208, -0.00327, -0.53108, 1.10813, -0.07276, -0.07367, -0.00605, 1.07602);
vec3 RRTODT(vec3 v) { vec3 a = v * (v + 0.0245786) - 0.000090537; vec3 b = v * (0.983729 * v + 0.4329510) + 0.238081; return a / b; }
vec3 srgb(vec3 c) { return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(0.0031308, c)); }
void main() {
  ivec2 px = ivec2(gl_GlobalInvocationID.xy); if (any(greaterThanEqual(px, ivec2(F.res.xy)))) return;
  vec2 uv = (vec2(px) + 0.5) * F.res.zw;
  vec3 c = texture(hdrTex, uv).rgb;
  if (F.taa.w > 0.0) { // light sharpen after TAA (counteracts the history resampling softness; handbook: no TAA blur)
    vec3 nb = texture(hdrTex, uv + vec2(F.res.z, 0)).rgb + texture(hdrTex, uv - vec2(F.res.z, 0)).rgb + texture(hdrTex, uv + vec2(0, F.res.w)).rgb + texture(hdrTex, uv - vec2(0, F.res.w)).rgb;
    c = max(c + (c - nb * 0.25) * F.taa.w, 0.0); }
  if (F.post.y > 0.0) c += texture(bloomTex, uv).rgb * F.post.y; // bloom pass skipped when 0 (isolate runs): never read its image
  c *= F.post.x; c = clamp(ACESOut * RRTODT(ACESIn * c), 0.0, 1.0);
  imageStore(outLdr, px, vec4(srgb(c), dot(srgb(c), vec3(0.299, 0.587, 0.114))));
}
