{
 "version": 1,
 "consts": {
  "g": 9.81,
  "rho": 1.225,
  "crr": 0.012,
  "eta": 0.9
 },
 "vars": [
  {
   "n": "m",
   "e": "car.mass"
  },
  {
   "n": "a",
   "e": "front.hub#0"
  },
  {
   "n": "b",
   "e": "-rear.hub#0"
  },
  {
   "n": "L",
   "e": "a + b"
  },
  {
   "n": "tf",
   "e": "2*front.hub#1"
  },
  {
   "n": "tr",
   "e": "2*rear.hub#1"
  },
  {
   "n": "rf",
   "e": "front.tyre_radius"
  },
  {
   "n": "rr",
   "e": "rear.tyre_radius"
  },
  {
   "n": "h",
   "e": "rf - front.hub#2"
  },
  {
   "n": "wf",
   "e": "b/L"
  },
  {
   "n": "fzf",
   "e": "m*g*wf/2"
  },
  {
   "n": "fzr",
   "e": "m*g*(1-wf)/2"
  },
  {
   "n": "msf",
   "e": "m*wf/2 - front.unsprung_mass"
  },
  {
   "n": "msr",
   "e": "m*(1-wf)/2 - rear.unsprung_mass"
  },
  {
   "n": "kf",
   "e": "front.wheel_rate"
  },
  {
   "n": "kr",
   "e": "rear.wheel_rate"
  },
  {
   "n": "fnf",
   "e": "sqrt(kf/msf)/(2*pi)"
  },
  {
   "n": "fnr",
   "e": "sqrt(kr/msr)/(2*pi)"
  },
  {
   "n": "ccf",
   "e": "2*sqrt(kf*msf)"
  },
  {
   "n": "ccr",
   "e": "2*sqrt(kr*msr)"
  },
  {
   "n": "zbf",
   "e": "front.damp_bump/ccf"
  },
  {
   "n": "zrf",
   "e": "front.damp_reb/ccf"
  },
  {
   "n": "zbr",
   "e": "rear.damp_bump/ccr"
  },
  {
   "n": "zrr",
   "e": "rear.damp_reb/ccr"
  },
  {
   "n": "kpf",
   "e": "(kf + front.arb)*tf^2/2"
  },
  {
   "n": "kpr",
   "e": "(kr + rear.arb)*tr^2/2"
  },
  {
   "n": "rsf",
   "e": "100*kpf/(kpf + kpr)"
  },
  {
   "n": "rollg",
   "e": "deg(m*g*h/(kpf + kpr))"
  },
  {
   "n": "sagf",
   "e": "1000*fzf/kf"
  },
  {
   "n": "sagr",
   "e": "1000*fzr/kr"
  },
  {
   "n": "rwl",
   "e": "car.steer_lock_deg/car.steer_ratio"
  },
  {
   "n": "turns",
   "e": "2*car.steer_lock_deg/360"
  },
  {
   "n": "tcirc",
   "e": "2*(L/sin(rad(rwl)) + tf/2)"
  },
  {
   "n": "caster",
   "e": "deg(axis(0))"
  },
  {
   "n": "kpi",
   "e": "deg(axis(1))"
  },
  {
   "n": "toef",
   "e": "2*1000*2*rf*sin(rad(front.static_toe_deg))"
  },
  {
   "n": "toer",
   "e": "2*1000*2*rr*sin(rad(rear.static_toe_deg))"
  },
  {
   "n": "tbf",
   "e": "front.brake_torque"
  },
  {
   "n": "tbr",
   "e": "rear.brake_torque"
  },
  {
   "n": "bias",
   "e": "100*tbf/(tbf + tbr)"
  },
  {
   "n": "dmax",
   "e": "2*(tbf/rf + tbr/rr)/(m*g)"
  },
  {
   "n": "mxf",
   "e": "front.tyre_mu_x"
  },
  {
   "n": "mxr",
   "e": "rear.tyre_mu_x"
  },
  {
   "n": "fzbf",
   "e": "m*g*(b + h*dmax)/L/2"
  },
  {
   "n": "fzbr",
   "e": "max(m*g*(a - h*dmax)/L/2, 0)"
  },
  {
   "n": "limf",
   "e": "mxf*front.tyre_fz0*(fzbf/front.tyre_fz0)^front.tyre_ls_exp_x*rf"
  },
  {
   "n": "limr",
   "e": "mxr*rear.tyre_fz0*(fzbr/rear.tyre_fz0)^rear.tyre_ls_exp_x*rr"
  },
  {
   "n": "dlf",
   "e": "mxf*m*g*b/(2*L)*rf/(tbf/dmax - mxf*m*g*h/(2*L)*rf)"
  },
  {
   "n": "dlr",
   "e": "mxr*m*g*a/(2*L)*rr/(tbr/dmax + mxr*m*g*h/(2*L)*rr)"
  },
  {
   "n": "dlock",
   "e": "min(sel(dlf > 0, dlf, 99), dlr)"
  },
  {
   "n": "kzf",
   "e": "front.tyre_kz_ref + front.tyre_kz_per_pa*(front.tyre_pressure - front.tyre_pressure_ref)"
  },
  {
   "n": "kzr",
   "e": "rear.tyre_kz_ref + rear.tyre_kz_per_pa*(rear.tyre_pressure - rear.tyre_pressure_ref)"
  },
  {
   "n": "dzf",
   "e": "1000*fzf/kzf"
  },
  {
   "n": "dzr",
   "e": "1000*fzr/kzr"
  },
  {
   "n": "plf",
   "e": "1000*front.tyre_patch_factor*sqrt(2*rf*dzf/1000)*2"
  },
  {
   "n": "plr",
   "e": "1000*rear.tyre_patch_factor*sqrt(2*rr*dzr/1000)*2"
  },
  {
   "n": "csf",
   "e": "100*(0.35 + 0.65*min(front.tyre_pressure/front.tyre_pressure_ref, 1.5))"
  },
  {
   "n": "csr",
   "e": "100*(0.35 + 0.65*min(rear.tyre_pressure/rear.tyre_pressure_ref, 1.5))"
  },
  {
   "n": "hotf",
   "e": "(front.tyre_pressure/1000 + 101.3)*(273 + 50)/(273 + 20) - 101.3"
  },
  {
   "n": "hotr",
   "e": "(rear.tyre_pressure/1000 + 101.3)*(273 + 50)/(273 + 20) - 101.3"
  },
  {
   "n": "winf",
   "e": "100*clamp(1 - ((hotf - 225)/45)^2, 0, 1)"
  },
  {
   "n": "winr",
   "e": "100*clamp(1 - ((hotr - 225)/45)^2, 0, 1)"
  },
  {
   "n": "tpk",
   "e": "tmax()"
  },
  {
   "n": "ppk",
   "e": "pmax()"
  },
  {
   "n": "axt1",
   "e": "tpk*gear(1)*car.final_drive"
  },
  {
   "n": "lockp",
   "e": "car.diff_preload + car.diff_power*axt1"
  },
  {
   "n": "lockc",
   "e": "car.diff_preload + car.diff_coast*car.coast_torque*gear(1)*car.final_drive"
  },
  {
   "n": "visc100",
   "e": "car.diff_viscous*100*2*pi/60"
  },
  {
   "n": "v1",
   "e": "vgear(1)"
  },
  {
   "n": "v2",
   "e": "vgear(2)"
  },
  {
   "n": "v3",
   "e": "vgear(3)"
  },
  {
   "n": "v4",
   "e": "vgear(4)"
  },
  {
   "n": "v5",
   "e": "vgear(5)"
  },
  {
   "n": "v6",
   "e": "vgear(6)"
  },
  {
   "n": "d12",
   "e": "car.limiter_rpm*(1 - gear(2)/gear(1))"
  },
  {
   "n": "d23",
   "e": "car.limiter_rpm*(1 - gear(3)/gear(2))"
  },
  {
   "n": "d34",
   "e": "car.limiter_rpm*(1 - gear(4)/gear(3))"
  },
  {
   "n": "d45",
   "e": "car.limiter_rpm*(1 - gear(5)/gear(4))"
  },
  {
   "n": "vt",
   "e": "vtop()"
  },
  {
   "n": "q100",
   "e": "0.5*rho*(100/3.6)^2"
  },
  {
   "n": "q200",
   "e": "0.5*rho*(200/3.6)^2"
  },
  {
   "n": "dr200",
   "e": "car.cda*q200"
  },
  {
   "n": "df200f",
   "e": "car.cla_front*q200"
  },
  {
   "n": "df200r",
   "e": "car.cla_rear*q200"
  },
  {
   "n": "abal",
   "e": "sel(abs(car.cla_front + car.cla_rear) > 0.0001, 100*car.cla_front/(car.cla_front + car.cla_rear), 50)"
  },
  {
   "n": "pdrag",
   "e": "car.cda*0.5*rho*(vt/3.6)^3/1000"
  },
  {
   "n": "izz",
   "e": "car.sprung_inertia#2 + 2*front.unsprung_mass*(a^2 + (tf/2)^2) + 2*rear.unsprung_mass*(b^2 + (tr/2)^2)"
  },
  {
   "n": "pw",
   "e": "ppk/(m/1000)"
  }
 ],
 "overlay_default": {
  "when": {
   "front.tyre_width": [
    0.182,
    0.188
   ],
   "front.tyre_radius": [
    0.285,
    0.293
   ]
  },
  "keys": {
   "tyre_mu_y": "0.955",
   "tyre_mu_x": "0.926",
   "tyre_ls_exp_y": "0.90",
   "tyre_ls_exp_x": "0.92"
  }
 },
 "pages": [
  {
   "id": "align",
   "title": "ALIGNMENT & STEERING",
   "unity": "08",
   "panel": "align",
   "rows": [
    {
     "k": "front.static_camber_deg",
     "l": "Camber",
     "u": "deg",
     "min": -5,
     "max": 5,
     "st": 0.1,
     "d": 1,
     "k2": "rear.static_camber_deg",
     "lim": [
      -3,
      0
     ],
     "i": "Static camber at design ride height. Negative = top of the wheel leans in; more negative widens the cornering contact patch but costs braking and traction in a straight line."
    },
    {
     "k": "front.static_toe_deg",
     "l": "Toe",
     "u": "deg / side",
     "min": -1,
     "max": 1,
     "st": 0.01,
     "d": 2,
     "k2": "rear.static_toe_deg",
     "lim": [
      -0.2,
      0.3
     ],
     "i": "Static toe per side, + = toe-in. Front toe-out sharpens turn-in; rear toe-in adds straight-line stability."
    },
    {
     "k": "car.steer_ratio",
     "l": "Steering ratio",
     "u": ":1",
     "min": 10,
     "max": 20,
     "st": 0.1,
     "d": 1,
     "lim": [
      12,
      17
     ],
     "i": "Steering-wheel angle per road-wheel angle. Lower = quicker steering."
